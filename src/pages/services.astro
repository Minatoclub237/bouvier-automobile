---
import Base from '../layouts/Base.astro';
import { services } from '../data/site.js';
const args = ['Véhicules propres et entretenus', 'Assurance comprise', 'Réservation en ligne 24 h/24', 'Dernière minute acceptée', 'Équipements hiver sur demande', 'Un interlocuteur réactif'];
---
<Base title="Services : location, utilitaires, achat-revente, reprise" description="Location de citadines, d’une compacte cinq places et d’utilitaires à Aix-les-Bains et Annecy, équipements montagne, achat-revente et reprise de véhicules : tous les services de Bouvier Automobile.">
  <section class="phero" id="top">
    <div class="phero__media"><video data-autoplay muted loop playsinline preload="none" poster="/loops/cockpit.webp" data-src="/loops/cockpit.mp4" aria-hidden="true"></video></div>
    <div class="phero__inner">
      <span class="label">Location · achat-revente · reprise</span>
      <h1 class="js-chars">Nos services</h1>
      <p>Louer une voiture pour un week-end, un utilitaire pour un déménagement, ou vendre la vôtre : nous vous accompagnons avec professionnalisme.</p>
    </div>
  </section>

  <section class="section">
    <div class="srv">
      {services.map((s, i) => (
        <article class="srv__item" id={s.key}>
          <figure class="srv__media">
            <img src={`${s.page}.webp`} alt="" loading="lazy" class="js-parallax" data-speed="6" />
          </figure>
          <div class="srv__text">
            <span class="label">Service {String(i + 1).padStart(2, '0')}</span>
            <h2 class="js-chars">{s.title}</h2>
            <p>{s.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tight">
    <div class="section__head"><span class="label">Pourquoi Bouvier Automobile</span><h2 class="js-chars">Six engagements</h2></div>
    <ul class="args">{args.map((a, i) => <li class="js-reveal"><i>0{i + 1}</i>{a}</li>)}</ul>
    <div class="ctas" style="margin-top:6vh"><a class="cta cta--fill" href="/flotte"><span>Voir nos véhicules</span><b aria-hidden="true">→</b></a><a class="cta" href="/vendre"><span>Vendre ma voiture</span><b aria-hidden="true">→</b></a></div>
  </section>

  <style>
    .srv { display: grid; gap: 14vh; }
    .srv__item { display: grid; grid-template-columns: 1fr 1fr; gap: 6vw; align-items: center; scroll-margin-top: calc(var(--hdr-h) + 4vh); }
    .srv__item:nth-child(even) .srv__media { order: 2; }
    .srv__media { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: var(--panel-2); max-height: 82vh; }
    .srv__media img, .srv__media video { width: 100%; height: 115%; object-fit: cover; }
    .srv__media video { height: 100%; }
    .srv__text { display: grid; gap: 18px; max-width: 520px; }
    .srv__text h2 { font-size: var(--fs-h2); }
    .srv__text p { color: #d4d0cb; font-size: max(17px, 1.15vw); }
    .args { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 3vw; }
    .args li { display: flex; gap: 18px; align-items: baseline; padding: 26px 0; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: var(--fs-h3); line-height: 1.1; }
    .args i { font-style: normal; font-family: var(--sans); font-size: var(--fs-label); font-weight: 600; letter-spacing: .2em; color: var(--accent); }
    @media (max-width: 900px) {
      .srv__item { grid-template-columns: 1fr; gap: 4vh; }
      .srv__item:nth-child(even) .srv__media { order: 0; }
      .args { grid-template-columns: 1fr; }
    }
  </style>
</Base>
