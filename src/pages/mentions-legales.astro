---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Mentions légales" description="Mentions légales du site bouvierautomobile.com, édité par BOUVIER AUTOMOBILE SAS.">
  <section class="section" id="top" style="padding-top:calc(var(--hdr-h) + 12vh)">
    <div class="prose">
      <span class="label">Informations légales</span>
      <h1 style="font-size:var(--fs-h2)">Mentions légales</h1>

      <h2>Éditeur du site</h2>
      <p>{site.legal}, société par actions simplifiée{site.capital && ` au capital de ${site.capital}`}.<br />
        Siège social : {site.seat}, France.<br />
        SIREN {site.siren} — SIRET {site.siret} — RCS Paris {site.siren}.<br />
        N° de TVA intracommunautaire : {site.vat}.<br />
        Téléphone : <a href={site.phoneHref}>{site.phone}</a> — E-mail : <a href={`mailto:${site.email}`}>{site.email}</a></p>

      <h2>Directeur de la publication</h2>
      <p>{site.president}, président de {site.legal}.</p>

      <h2>Hébergement</h2>
      <p>Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis — vercel.com.</p>

      <h2>Propriété intellectuelle</h2>
      <p>Les textes et photos de ce site appartiennent à {site.legal}, sauf mention contraire. Les médias de tiers sont listés sur la page <a href="/credits">Crédits</a> avec leur licence. Toute reproduction sans autorisation est interdite.</p>

      <h2>Locations</h2>
      <p>Les réservations, paiements et assurances des locations sont gérés par les plateformes Turo et Getaround, selon leurs propres conditions générales. Les informations des fiches véhicules (équipements, kilométrage, disponibilité) sont données à titre indicatif.</p>

      <h2>Données personnelles</h2>
      <p>Voir notre <a href="/confidentialite">politique de confidentialité</a>.</p>
    </div>
  </section>
</Base>
