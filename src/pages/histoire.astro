---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
const chapters = [
  { k: 'Les débuts', t: 'Louer simplement, au juste prix', p: 'Fabrice Bouvier commence par louer ses voitures entre particuliers, sur Turo et Getaround, autour d’Aix-les-Bains. Son idée : des véhicules fiables, propres et prêts pour la montagne, loués simplement et au meilleur prix.', img: '/media/c1-annecy' },
  { k: 'La confiance', t: 'Plus de 350 locations', p: `Plus de 350 locations et une note moyenne de ${site.rating.value} / 5 sur ${site.rating.count} avis. Sur Turo, Bouvier Automobile a le statut « Hôte Star », réservé aux hôtes les mieux notés et les plus fiables.`, img: '/media/308-lac' },
  { k: 'Aujourd’hui', t: 'Location, achat et revente', p: `En ${site.incorporated}, l’activité devient la société ${site.legal}. Six modèles à louer à Aix-les-Bains et à Annecy, et un nouveau métier : l’achat, la revente et la reprise de véhicules sélectionnés avec soin.`, img: '/media/aygo' },
];
---
<Base footer="/media/c1-route.webp" title="Qui sommes-nous" description="Bouvier Automobile, entreprise locale fondée par Fabrice Bouvier : location de voitures et d’utilitaires à Aix-les-Bains, Chambéry et Annecy, achat-revente et reprise de véhicules.">
  <section class="phero" id="top">
    <div class="phero__media"><img src="/media/twingo.webp" alt="La Renault Twingo rouge de Bouvier Automobile" /></div>
    <div class="phero__inner">
      <span class="label">Bouvier Automobile · Aix-les-Bains</span>
      <h1 class="js-chars">Qui sommes-nous</h1>
      <p>Votre partenaire automobile de confiance : des voitures fiables, propres et au meilleur prix, entre le lac du Bourget et Annecy.</p>
    </div>
  </section>

  <section class="section">
    <div class="story">
      {chapters.map((c, i) => (
        <article class="story__item">
          <figure class="story__media"><img src={`${c.img}.webp`} alt="" loading="lazy" class="js-parallax" data-speed="8" /></figure>
          <div class="story__text">
            <span class="label">0{i + 1} · {c.k}</span>
            <h2 class="js-chars">{c.t}</h2>
            <p>{c.p}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tight">
    <div class="team">
      <div class="js-reveal"><span class="label">Président</span><h3>{site.president}</h3></div>
      <div class="js-reveal"><span class="label">Turo</span><h3>Hôte Star · {site.ratings.turo.trips} voyages</h3></div>
      <div class="js-reveal"><span class="label">Note moyenne</span><h3>{site.rating.value} / 5 · {site.rating.count} avis</h3></div>
    </div>
  </section>

  <style>
    .story { display: grid; gap: 16vh; }
    .story__item { display: grid; grid-template-columns: 1fr 1fr; gap: 6vw; align-items: center; }
    .story__item:nth-child(even) .story__media { order: 2; }
    .story__media { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; max-height: 80vh; }
    .story__media img { width: 100%; height: 118%; object-fit: cover; }
    .story__text { display: grid; gap: 18px; max-width: 540px; }
    .story__text h2 { font-size: var(--fs-h2); }
    .story__text p { color: #d4d0cb; font-size: max(17px, 1.15vw); }
    .team { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3vw; border-top: 1px solid var(--line); padding-top: 5vh; }
    .team h3 { font-size: var(--fs-h3); margin-top: 10px; }
    @media (max-width: 900px) {
      .story__item, .team { grid-template-columns: 1fr; gap: 4vh; }
      .story__item:nth-child(even) .story__media { order: 0; }
    }
  </style>
</Base>
