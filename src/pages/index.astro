---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { site, services, steps, pillars } from '../data/site.js';
import fleet from '../data/fleet.json';
import reviews from '../data/reviews.json';
import { siCitroen, siPeugeot, siRenault, siToyota } from 'simple-icons';

const trail = fleet.flatMap((v) => ['01', '02'].map((p) => `/flotte/${v.ref}/${p}-s.webp`));
const makes = [...new Set(fleet.map((v) => v.marque))];
// logos des marques de la flotte (simple-icons), répétés pour remplir la bande
const icons = { Citroën: siCitroen, Peugeot: siPeugeot, Renault: siRenault, Toyota: siToyota };
const logos = makes.map((m) => ({ id: m.toLowerCase().normalize('NFD').replace(/[^a-z]/g, ''), name: m, svg: icons[m] && `<path d="${icons[m].path}"/>` })).filter((l) => l.svg);
const row = [...logos, ...logos, ...logos];
const clip = (t, n = 250) => (t.length > n ? t.slice(0, t.lastIndexOf(' ', n)) + '…' : t);
---
<Base description="Bouvier Automobile, location de voitures et d’utilitaires à Aix-les-Bains, Chambéry et Annecy sur Turo et Getaround, achat-revente et reprise de véhicules. Plus de 350 locations, 4,9 / 5 de moyenne.">
  <link slot="head" rel="preload" as="image" href="/hero/a-001.webp" fetchpriority="high" />

  <!-- 1. HERO : la caméra plonge sur le capot puis entre dans l'habitacle, au rythme du scroll -->
  <section class="hero" id="top">
    <div class="hero__stage">
      <canvas class="hero__canvas" id="heroCanvas" data-a="105" data-b="30" style="background-image:url(/hero/a-001.webp)" aria-hidden="true"></canvas>
      <div class="hero__shade"></div>
      <div class="hero__veil" id="heroVeil"></div>

      <h1 class="hero__title js-words">Louez votre voiture<br /><em>en toute simplicité</em></h1>
      <div class="hero__foot">
        <p class="hero__sub">Citadines, compacte et utilitaires à Aix-les-Bains, Chambéry et Annecy. Des véhicules entretenus, réservables en ligne sur Turo et Getaround.</p>
        <div class="ctas" style="justify-content:center">
          <a class="cta cta--fill" href="/flotte"><span>Voir nos véhicules</span><b aria-hidden="true">→</b></a>
          <a class="cta" href="/vendre"><span>Vendre ma voiture</span><b aria-hidden="true">→</b></a>
        </div>
      </div>

      <div class="trail" id="trail" aria-hidden="true" data-src={JSON.stringify(trail)}></div>
      <p class="hero__statement js-words" aria-hidden="true">Fiables. Propres. <br />Au meilleur prix.</p>

      <!-- 2. MÉTHODE : le cadre s'ouvre depuis le centre -->
      <div class="approach" id="methode">
        <div class="approach__frame">
          <video class="approach__media" id="approachVideo" muted loop playsinline preload="none" poster="/loops/lac.webp" data-src="/loops/lac.mp4" aria-hidden="true"></video>
          <div class="approach__shade"></div>
          <div class="approach__content">
            <div class="approach__head">
              <h2 class="approach__title js-chars">Votre location<br />en quatre étapes</h2>
              <svg class="approach__arc" viewBox="0 0 60 300" preserveAspectRatio="none" aria-hidden="true"><path d="M8 4 C 62 80, 62 220, 8 296" pathLength="100" /></svg>
            </div>
            <ol class="steps">
              {steps.map((s) => <li><i>{s.n}</i><b>{s.title}</b><span>{s.text}</span></li>)}
            </ol>
            <div class="approach__bottom">
              <div class="marquee" role="img" aria-label={`Marques de notre flotte : ${makes.join(', ')}`}>
                <svg width="0" height="0" style="position:absolute" aria-hidden="true">
                  {logos.map((l) => <symbol id={`logo-${l.id}`} viewBox="0 0 24 24" set:html={l.svg} />)}
                </svg>
                <div class="marquee__track" aria-hidden="true">
                  {[...row, ...row].map((l) => <span class="marquee__logo" title={l.name}><svg><use href={`#logo-${l.id}`} /></svg></span>)}
                </div>
              </div>
              <a class="cta cta--fill" href="/flotte"><span>Choisir mon véhicule</span><b aria-hidden="true">→</b></a>
            </div>
          </div>
        </div>
      </div>

      <button class="cue" id="cue" type="button"><span>Faites défiler</span><i></i></button>
    </div>
  </section>

  <!-- 3. POURQUOI BOUVIER : la carte reste, les vidéos s'ouvrent depuis le centre -->
  <section class="pillars" aria-label="Pourquoi Bouvier Automobile">
    <div class="pillars__sticky">
      <div class="pillars__bg" aria-hidden="true">
        {pillars.map((p) => <img src={`/media/${p.video.split('/').pop()}-blur.webp`} alt="" loading="lazy" />)}
      </div>
      <div class="pillars__card">
        {pillars.map((p) => <video data-autoplay muted loop playsinline preload="none" poster={`${p.video}.webp`} data-src={`${p.video}.mp4`} aria-hidden="true"></video>)}
      </div>
    </div>
    <div class="pillars__list">
      {pillars.map((p, i) => (
        <article class="pillar">
          <span class="pillar__count">0{i + 1} <i>/ 0{pillars.length}</i></span>
          <h2 class="pillar__title js-chars">{p.title}</h2>
          <p>{p.text}</p>
          <a class="cta" href="/flotte"><span>Voir nos véhicules</span><b aria-hidden="true">→</b></a>
        </article>
      ))}
    </div>
  </section>

  <!-- 4. UNE ENTREPRISE LOCALE : le texte s'allume lettre à lettre -->
  <section class="manifesto">
    <div class="manifesto__text">
      <p class="manifesto__big js-chars js-chars--long">Une entreprise locale, entre le lac du Bourget, Chambéry et Annecy.</p>
      <p class="manifesto__small">Chez Bouvier Automobile, nous privilégions la transparence, la qualité et la satisfaction de nos clients. Chaque véhicule est soigneusement préparé afin de garantir une expérience sans mauvaise surprise.</p>
      <a class="cta" href="/histoire"><span>Qui sommes-nous</span><b aria-hidden="true">→</b></a>
    </div>
    <figure class="manifesto__img"><img src="/media/308-lac.webp" alt="La Peugeot 308 de Bouvier Automobile au bord du lac" loading="lazy" /></figure>
  </section>

  <!-- 5. SERVICES : chaque image monte et recouvre la précédente -->
  <section class="services" id="services" aria-label="Nos services">
    <div class="services__list">
      {services.map((s, i) => (
        <article class="svc">
          <span class="label">Service {String(i + 1).padStart(2, '0')}</span>
          <h2 class="svc__title js-chars">{s.title}</h2>
          <p>{s.text}</p>
          <a class="cta" href={`/services#${s.key}`}><span>En savoir plus</span><b aria-hidden="true">→</b></a>
        </article>
      ))}
    </div>
    <div class="services__media" aria-hidden="true">
      <div class="services__sticky">
        {services.map((s) => (
          <figure class="svc-img">
            {s.media.video
              ? <video data-autoplay muted loop playsinline preload="none" poster={`${s.media.video}.webp`} data-src={`${s.media.video}.mp4`}></video>
              : <img src={`${s.media.img}.webp`} alt="" loading="lazy" />}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. +350 LOCATIONS : la voiture traverse, les voisines vont moins vite -->
  <section class="standard">
    <h2 class="standard__word js-chars">{site.rentals}</h2>
    <div class="standard__road" aria-hidden="true">
      <img class="standard__side standard__side--l" src="/img/top-left.webp" alt="" loading="lazy" />
      <img class="standard__car" src="/img/top-car.webp" alt="" loading="lazy" />
      <img class="standard__side standard__side--r" src="/img/top-right.webp" alt="" loading="lazy" />
    </div>
    <div class="standard__end">
      <h2 class="standard__word js-chars">locations</h2>
      <p>Forts de plus de 350 locations réalisées, nous avons déjà gagné la confiance de nombreux voyageurs : {site.rating.value} / 5 de moyenne sur Turo, Getaround et Google. Avec nous, vous louez en toute sérénité.</p>
    </div>
  </section>

  <!-- 7. FLOTTE → REPRISE : la section suivante recouvre la précédente -->
  <section class="cover cover--a" id="flotte-teaser">
    <div class="cover__media"><img src="/media/308-lac-large.webp" alt="Peugeot 308 rouge de Bouvier Automobile face au lac" loading="lazy" /></div>
    <div class="cover__content">
      <h2 class="cover__title js-chars">Nos véhicules</h2>
      <p>{fleet.length} modèles à louer, des citadines aux utilitaires, à Aix-les-Bains et à Annecy. Réservation en ligne, assurance comprise.</p>
      <a class="cta" href="/flotte"><span>Voir les véhicules</span><b aria-hidden="true">→</b></a>
    </div>
  </section>
  <section class="cover cover--b">
    <div class="cover__media"><img src="/media/megane-rs.webp" alt="Renault Mégane R.S. orange" loading="lazy" /></div>
    <div class="cover__content">
      <h2 class="cover__title js-chars">Vous vendez ?</h2>
      <p>Nous reprenons votre véhicule, roulant ou non, en bon état ou à réparer. Une estimation rapide, une offre juste et un rachat simplifié.</p>
      <a class="cta cta--fill" href="/vendre"><span>Faire reprendre ma voiture</span><b aria-hidden="true">→</b></a>
    </div>
  </section>

  <!-- 8. AVIS : bande horizontale pilotée par le scroll -->
  <section class="reviews" aria-label="Avis clients">
    <div class="reviews__pin">
      <div class="reviews__head">
        <h2 class="js-chars">Ils ont roulé<br />avec nous</h2>
        <div class="reviews__score">
          <b>{site.rating.value}</b>
          <div><div class="stars" aria-hidden="true">★★★★★</div><span class="label">{site.rating.count} avis Turo, Getaround et Google</span></div>
        </div>
      </div>
      <div class="reviews__track" id="reviewsTrack">
        {reviews.map((r) => (
          <article class="review">
            <div class="stars" aria-label={`${r.etoiles} étoiles sur 5`}>★★★★★</div>
            <p>« {clip(r.texte)} »</p>
            <footer><b>{r.auteur}</b><span>{r.source} · {r.date}</span></footer>
          </article>
        ))}
        <a class="review review--cta" href={site.getaround} target="_blank" rel="noopener">
          <p>Lire les {site.ratings.getaround.count} avis sur Getaround</p>
          <span class="label" style="color:#fff">Profil Bouvier Automobile →</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    import '../scripts/home.js';
  </script>
</Base>
