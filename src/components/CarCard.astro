---
const { v } = Astro.props;
---
<a class="car js-reveal" href={`/flotte/${v.slug}`} data-categorie={v.categorie}>
  <div class="car__img">
    <img src={`/flotte/${v.ref}/01-s.webp`} alt={`${v.marque} ${v.modele} ${v.annee}, location à ${v.ville}`} loading="lazy" decoding="async" width="640" height="480" />
    <span class="car__price">{v.categorie}</span>
  </div>
  <h3>{v.marque} {v.modele}</h3>
  <p class="car__ver">{v.version} · {v.ville}</p>
  <p class="car__specs">{[v.annee, v.places && `${v.places} places`, v.energie, v.boite].filter(Boolean).map((x) => <span>{x}</span>)}</p>
</a>
